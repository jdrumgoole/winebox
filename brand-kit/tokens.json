{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "WineBox design tokens. These mirror the :root custom properties in winebox/static/css/style.css — that stylesheet is the source of truth; this file documents it.",
  "color": {
    "brand": {
      "burgundy":       { "value": "#5C0A2D", "comment": "Nav gradient end, Wine wordmark (light)" },
      "burgundy-light": { "value": "#8B1A4A", "comment": "Nav gradient start, primary color" },
      "rose":           { "value": "#B82860", "comment": "Bottle fill, primary-light" },
      "gold":           { "value": "#C49A3C", "comment": "Secondary / CTA accents, Box wordmark (light)" },
      "gold-light":     { "value": "#F0D78C", "comment": "Bottle labels, Box wordmark (dark)" },
      "case-wood":      { "value": "#B8956A", "comment": "Logo case fill (light theme)" },
      "case-wood-dark": { "value": "#A08060", "comment": "Logo case fill (dark theme)" },
      "case-stroke":    { "value": "#8A6C4E" },
      "case-grain":     { "value": "#907050" },
      "cream":          { "value": "#FAF7F2", "comment": "Page background — --cream" },
      "cream-dark":     { "value": "#F0EBE3", "comment": "Hero gradient end — --cream-dark" },
      "dark-bg":        { "value": "#1A0A10", "comment": "Dark mode background" },
      "dark-wine":      { "value": "#E0C0CC", "comment": "Wine wordmark (dark theme)" }
    },
    "semantic": {
      "primary":          { "value": "{color.brand.burgundy-light}" },
      "primary-light":    { "value": "{color.brand.rose}" },
      "primary-dark":     { "value": "{color.brand.burgundy}" },
      "secondary":        { "value": "{color.brand.gold}" },
      "background":       { "value": "{color.brand.cream}" },
      "card-background":  { "value": "#ffffff" },
      "text":             { "value": "#2D1A22" },
      "text-muted":       { "value": "#8A7A80" },
      "text-heading":     { "value": "#2C2C2C" },
      "text-body":        { "value": "#666666" },
      "border":           { "value": "#E8E0D8" },
      "success":          { "value": "#4a7c59" },
      "warning":          { "value": "#c9a227" },
      "error":            { "value": "#a63d40" }
    }
  },
  "gradient": {
    "nav-cta": { "value": "linear-gradient(135deg, #8B1A4A 0%, #5C0A2D 100%)", "comment": "Header, primary CTA backgrounds" },
    "hero":    { "value": "linear-gradient(135deg, #FAF7F2 0%, #F0EBE3 100%)", "comment": "Landing page hero" }
  },
  "font-family": {
    "wordmark":   { "value": "'Playfair Display', Georgia, serif",   "comment": "Logo only — 'Wine' 700 / 'Box' 400" },
    "tagline":    { "value": "'Cormorant Garamond', Georgia, serif", "comment": "Tagline & subtitles in brand contexts" },
    "heading":    { "value": "'Playfair Display', Georgia, serif",   "comment": "h1-h4 in app" },
    "body":       { "value": "'DM Sans', -apple-system, system-ui, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" }
  },
  "font-size": {
    "xs":   { "value": "0.75rem" },
    "sm":   { "value": "0.875rem" },
    "base": { "value": "1rem" },
    "md":   { "value": "1.1rem" },
    "lg":   { "value": "1.25rem" },
    "xl":   { "value": "1.6rem",  "comment": "Stat value" },
    "2xl":  { "value": "1.75rem", "comment": "h2" }
  },
  "font-weight": {
    "regular": { "value": 400 },
    "medium":  { "value": 500 },
    "bold":    { "value": 700 }
  },
  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.25rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" }
  },
  "radius": {
    "xs":   { "value": "2px",   "comment": "Beta badge and small pills" },
    "logo": { "value": "4px",   "comment": "Logo case corners only" },
    "sm":   { "value": "6px",   "comment": "Compact controls (select wrappers, progress tracks, thumbnails) — var(--radius-sm)" },
    "base": { "value": "8px",   "comment": "Buttons, inputs, nav pills — var(--radius)" },
    "lg":   { "value": "12px",  "comment": "Cards, modals — var(--radius-lg)" },
    "pill": { "value": "9999px" }
  },
  "shadow": {
    "base":  { "value": "0 2px 8px rgba(0, 0, 0, 0.08)",  "comment": "var(--shadow) — default elevation" },
    "md":    { "value": "0 4px 12px rgba(0, 0, 0, 0.1)",  "comment": "var(--shadow-md) — mid elevation (image thumbnails, floating controls)" },
    "hover": { "value": "0 4px 16px rgba(0, 0, 0, 0.12)", "comment": "var(--shadow-hover) — raised state" },
    "focus": { "value": "0 0 0 3px rgba(139, 26, 74, 0.1)", "comment": "Input focus ring" }
  },
  "layout": {
    "max-width":    { "value": "1400px", "comment": "Main content and header" },
    "main-padding": { "value": "2rem" }
  },
  "motion": {
    "duration-fast": { "value": "0.2s" },
    "easing":        { "value": "ease" }
  },
  "z-index": {
    "header": { "value": 100 },
    "modal":  { "value": 200 }
  }
}
