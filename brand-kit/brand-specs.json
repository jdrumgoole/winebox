  "logos": {
    "horizontal": {
      "file": "winebox_logo_horizontal.svg",
      "format": "SVG",
      "viewBox": "0 0 400 120",
      "width": 400,
      "height": 120,
      "aspectRatio": "3.33:1",
      "description": "Primary logo - color horizontal lockup with wordmark",
      "useCase": "Website headers, navigation, documents, marketing",
      "minSize": {
        "web": "180px",
        "print": "2 inches"
      },
      "exports": {
        "web": ["logo_horizontal_web.png", "logo_horizontal_web@2x.png", "logo_horizontal_web@3x.png"],
        "print": ["logo_horizontal_print_300dpi.png", "logo_horizontal_print_300dpi_large.png"]
      }
    },
    "icon": {
      "file": "winebox_icon.svg",
      "format": "SVG",
      "viewBox": "0 0 120 120",
      "width": 120,
      "height": 120,
      "aspectRatio": "1:1",
      "description": "Icon logo - color square symbol only",
      "useCase": "App icons, favicons, small spaces, social media",
      "minSize": {
        "web": "32px",
        "print": "0.5 inches"
      },
      "exports": {
        "web": ["icon_web_256.png", "icon_web_512.png", "icon_web_1024.png"],
        "print": ["icon_print_300dpi_2048.png"],
        "social": ["winebox_linkedin_400x400.png", "winebox_instagram_1080x1080.png", "winebox_twitter_400x400.png", "winebox_facebook_500x500.png"],
        "favicons": ["favicon_16.png", "favicon_32.png", "favicon_64.png", "favicon_128.png", "favicon_256.png", "favicon_512.png"]
      }
    },
    "monochrome": {
      "file": "winebox_logo_monochrome.svg",
      "format": "SVG",
      "viewBox": "0 0 400 120",
      "width": 400,
      "height": 120,
      "aspectRatio": "3.33:1",
      "description": "Single-color logo - for limited-color printing and embroidery",
      "useCase": "Embroidery, single-color printing, fax, press materials",
      "minSize": {
        "web": "180px",
        "print": "2 inches"
      },
      "exports": {
        "web": ["logo_monochrome_web.png", "logo_monochrome_web@2x.png"],
        "print": ["logo_monochrome_print_300dpi.png"]
      }
    }
  },
  "specifications": {
    "web": {
      "dpi": 72,
      "colorMode": "RGB",
      "format": "PNG",
      "transparency": "Yes",
      "sizes": {
        "logo": ["400x120", "800x240", "1600x480"],
        "icon": ["256x256", "512x512", "1024x1024"]
      }
    },
    "print": {
      "dpi": 300,
      "colorMode": "CMYK or RGB",
      "format": "PNG or PDF",
      "transparency": "No (or white background)",
      "sizes": {
        "logo": ["2400x720", "4800x1440"],
        "icon": ["2048x2048"]
      }
    },
    "email": {
      "width": "180-200px",
      "format": "PNG",
      "dpi": 72,
      "transparency": "Yes"
    },
    "social": {
      "linkedin": "400x400px",
      "instagram": "1080x1080px",
      "twitter": "400x400px",
      "facebook": "500x500px"
    },
    "favicon": {
